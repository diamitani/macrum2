# Macrum 2 environment variables — NAMES ONLY, no values.
# Copy to `.env.local` and fill in locally. NEVER commit `.env.local`.
# All keys are SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix) — never expose to the browser.

# Twenty CRM (server-side sync, app/api/twenty/*)
TWENTY_API_KEY=
TWENTY_API_URL=

# AI features (OpenRouter-compatible; app degrades gracefully without a key)
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
